# Managed PostgreSQL URL. Supabase/Neon Marketplace also supply POSTGRES_URL_NON_POOLING.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Keep this fixed; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VIKUNJA_SERVICE_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET
# Optional on Vercel: defaults to https://$VERCEL_URL/
VIKUNJA_SERVICE_PUBLICURL=https://hirayama-suporte.vercel.app/
# Private S3-compatible bucket (for example Supabase Storage).
VIKUNJA_FILES_S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
VIKUNJA_FILES_S3_BUCKET=hirayama-anexos
VIKUNJA_FILES_S3_REGION=us-east-1
VIKUNJA_FILES_S3_ACCESSKEY=REPLACE_WITH_STORAGE_ACCESS_KEY
VIKUNJA_FILES_S3_SECRETKEY=REPLACE_WITH_STORAGE_SECRET_KEY
VIKUNJA_FILES_S3_USEPATHSTYLE=true
# Enable temporarily to create the initial account, then disable again.
VIKUNJA_SERVICE_ENABLEREGISTRATION=false
